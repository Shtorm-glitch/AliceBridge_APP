<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- KernelSU forks are discovered by their libksud.so, independent of package name. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="df.root" />
        <package android:name="be.mygod.vpnhotspot" />
        <package android:name="com.yandex.iot" />
    </queries>
    <application android:label="AliceBridge" android:theme="@style/AppTheme" android:icon="@drawable/ic_bridge" android:allowBackup="false" android:dataExtractionRules="@xml/backup_rules" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:multiprocess="false" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".ShizukuGuideActivity" android:exported="false" />
        <activity android:name=".TerminalActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".YsePackages" android:exported="false" />
        <activity android:name=".YamActivity" android:exported="false" />
        <activity android:name=".UpdateActivity" android:exported="false" />
        <activity android:name=".HomeWifiActivity" android:exported="false" />
        <provider android:name=".UpdateProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".DiagnosticProvider" android:authorities="${applicationId}.diagnostics" android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".BridgeService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User started DNS diagnostic proxy for a local Wi-Fi hotspot" />
        </service>
    </application>
</manifest>
